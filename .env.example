PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DB_PROVIDER=mysql

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=base_api

# MongoDB provider settings (used when DB_PROVIDER=mongodb)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=base_api

ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# Comma-separated allowed origins for browser clients
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:4200,http://localhost:8100

# Optional log directory override
LOG_DIR=./logs
